# ---------------------------------------------------------------------------
# Local environment file (.env) — holds real credentials. NEVER commit this.
# Credentials committed to git stay in history even after deletion, so
# recovering means rotating every password AND rewriting history for everyone.
# ---------------------------------------------------------------------------
# Personal overrides of .claude/settings.json.
.claude/settings.local.json

# Credential files
.env
.env.*
!.env.example
*credentials*.json
*secrets*.y*ml
*.pem
*.key

# ---------------------------------------------------------------------------
# Project documents NEVER go to GitHub. knowledge-base/ commits only its map:
# READMEs, INDEX.md files and sync-config.json. The documents themselves are
# downloaded locally from Google Drive by the qa-kb-sync skill.
# Sync manifests, listings and SYNC_LOG.md are per-machine state, covered by this too.
# ---------------------------------------------------------------------------
knowledge-base/**
!knowledge-base/**/
!knowledge-base/README.md
!knowledge-base/sync-config.json
!knowledge-base/**/INDEX.md
!knowledge-base/**/.gitkeep

# Pipeline runtime state — per machine, never committed.
.auth/
state/
logs/
reports/_attachments/

# Tooling run artefacts — regenerate rather than commit.
# (test-cases/, reports/ and bug-evidence/ ARE tracked — they are the team's QA record.)
/screenshots/
test-results/
playwright-report/

# Network captures (HAR) carry session cookies and auth headers — never commit them,
# not even as bug evidence. Copy the relevant request/response into evidence.md instead.
*.har

# Office lock files
~$*

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
npm-debug.log*
