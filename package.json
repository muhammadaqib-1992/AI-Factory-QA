{
  "name": "ai-factory-qa",
  "private": true,
  "description": "Headless Jira → test cases → Playwright/NetSuite execution → bugs → PDF report pipeline for Claude Code.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup:browsers": "playwright install --with-deps chromium",
    "check": "node scripts/check-setup.mjs",
    "login": "node scripts/netsuite-login.mjs",
    "check:session": "node scripts/check-netsuite-session.mjs",
    "report": "node scripts/build-report.mjs",
    "finalize": "node scripts/finalize-run.mjs",
    "test": "node --test tests/mcp-servers.test.mjs tests/linux-smoke.test.mjs",
    "postinstall": "node scripts/link-netsuite-sessions.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@playwright/mcp": "0.0.83",
    "@suiteinsider/netsuite-mcp": "1.0.2",
    "marked": "18.1.0",
    "mcp-remote": "0.14.3",
    "playwright": "1.64.0-alpha-1790635538000",
    "zod": "^3.25.0"
  }
}
