# ---------------------------------------------------------------------------
# AI-Factory-QA — environment file (TEMPLATE)
#
#   cp .env.example .env && chmod 600 .env
#
# .env is git-ignored. Never commit it. .mcp.json reads these values as ${VAR},
# so start Claude through scripts/with-env.sh (it exports this file first):
#
#   scripts/with-env.sh claude
# ---------------------------------------------------------------------------

# ===== MCP: Jira (Atlassian remote MCP via mcp-remote) =====================
# OAuth, signed in once per machine (scripts/mcp-auth.sh jira). Tokens are cached
# in ~/.mcp-auth. The port is the local OAuth callback; tunnel it over SSH for the
# first sign-in on a headless server.
JIRA_MCP_CALLBACK_PORT=3334

# ===== MCP: GitHub (official remote MCP) ===================================
# Personal access token (classic): scopes repo, read:org, read:user, workflow.
GITHUB_PERSONAL_ACCESS_TOKEN=<PASTE_YOUR_PAT>

# ===== MCP: Google Drive ====================================================
# Absolute paths. gdrive-credentials.json is the shared OAuth app file; the token
# file is created by the one-time sign-in (scripts/mcp-auth.sh gdrive).
GDRIVE_OAUTH_PATH=/home/<USER>/.config/ai-factory-qa/gdrive-credentials.json
GDRIVE_CREDENTIALS_PATH=/home/<USER>/.config/ai-factory-qa/gdrive-token.json

# ===== MCP: NetSuite (@suiteinsider/netsuite-mcp, OAuth 2.0 PKCE) ===========
# Integration record: Authorization Code Grant + Public Client, scope
# NETSUITE AI CONNECTOR SERVICE, redirect http://localhost:8080/callback.
# Signed in once per machine (scripts/mcp-auth.sh netsuite); tokens are kept in
# .auth/netsuite-mcp/ and refresh automatically.
NETSUITE_ACCOUNT_ID=<ACCOUNT_ID>
NETSUITE_CLIENT_ID=<CLIENT_ID>
NETSUITE_OAUTH_CALLBACK_PORT=8080

# ===== Playwright MCP ======================================================
# Browser for the Playwright MCP. Linux: leave unset (bundled Chromium, headless).
# Windows with Smart App Control blocking the bundled Chromium: chrome (installed Chrome).
# PLAYWRIGHT_BROWSER=chromium

# ===== NetSuite UI login (Playwright) =======================================
# Used only by scripts/netsuite-login.mjs, which signs in headless and saves the
# session to .auth/netsuite-state.json for the Playwright MCP. The agent never
# sees these values.
# Account comes from NETSUITE_ACCOUNT_ID above.
# NS_APP_URL=https://<account-id>.app.netsuite.com
NS_EMAIL=<LOGIN_EMAIL>
# Quote the password if it contains spaces or a #:  NS_PASSWORD="my pass#word"
NS_PASSWORD=<LOGIN_PASSWORD>
# 2FA secret key (base32, e.g. JBSWY3DPEHPK3PXP). Only if NetSuite asks this user for a
# verification code. It is the key behind the authenticator QR code: NetSuite shows it
# under "Can't scan the code?" when 2FA is set up (Home > Settings > Manage 2FA / reset
# it there to get a new one). Add the same key to your phone app so both stay in step.
# Leave empty if 2FA is off for this user/role.
NS_TOTP_SECRET=
# Role to pick if NetSuite shows the role chooser after login, e.g. "Administrator".
NS_ROLE_NAME=

# ===== QA pipeline (scripts/run-pipeline.mjs) ===============================
# Which tickets are picked up automatically: project + status + assignee + label.
JIRA_SITE=folio3.atlassian.net
JIRA_PROJECT_KEY=NU
JIRA_READY_STATUS=Ready for QA
# currentUser() = the Atlassian account the Jira MCP is signed in as.
JIRA_QA_ASSIGNEE=currentUser()
JIRA_PICKUP_LABEL=AI_FActory
# Or replace all of the above with your own query:
# JIRA_PICKUP_JQL=project = NU AND status = "Ready for QA" AND labels = "AI_FActory"
# Bugs for failed cases: filed as this type under the tested ticket, assigned to this account.
JIRA_BUG_ISSUE_TYPE=Sub-task
JIRA_BUG_ASSIGNEE_ACCOUNT_ID=<SHAHZAIB_ACCOUNT_ID>
# Label added to every bug the pipeline files — how it finds them again for retest.
JIRA_BUG_LABEL=ai-qa-bug
# Retest outcome: bug moved to this status when it passes / when it fails.
JIRA_CLOSE_STATUS=Done / Closed
JIRA_REOPEN_STATUS=Reopen
# Limits
QA_MAX_TICKETS_PER_RUN=5
QA_TICKET_TIMEOUT_MIN=45
QA_MAX_ATTEMPTS=2
# Claude Code command (npm install -g @anthropic-ai/claude-code)
CLAUDE_BIN=claude

# ===== Claude Code ==========================================================
# Needed only if this machine is not signed in with `claude login`.
# ANTHROPIC_API_KEY=
